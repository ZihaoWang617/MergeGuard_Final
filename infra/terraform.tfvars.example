region = "us-east-1"
project = "mergeguard"
scanner_image = "docker.io/YOUR_DOCKERHUB_USERNAME/mergeguard@sha256:REPLACE_WITH_REAL_DIGEST"
lab_role_arn = "arn:aws:iam::123456789012:role/LabRole"
github_secret_arn = "arn:aws:secretsmanager:us-east-1:123456789012:secret:mergeguard/github-xxxxxx"
allowed_repo = "YOUR_GITHUB_USERNAME/YOUR_PUBLIC_TEST_REPO"
demo_user_sub = "REPLACE_AFTER_CREATING_COGNITO_USER"
cognito_domain_prefix = "mergeguard-your-unique-lab-prefix"
dashboard_callback_url = "http://localhost:8000/"
